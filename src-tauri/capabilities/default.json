{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Revdown main window can call only explicitly registered core commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-background-color",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging"
  ]
}
