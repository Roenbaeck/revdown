{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Revdown",
  "version": "0.1.1",
  "identifier": "app.revdown.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "windows": [
      {
        "title": "Revdown",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#f3f0e9",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 18 },
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Review Markdown without changing the source",
    "longDescription": "A local-first desktop application for precise Markdown review comments and portable review exports.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
